# Providers ao vivo (nunca commite valores reais)
GROQ_API_KEY=
NVIDIA_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
DEMO_PRIMARY_PROVIDER=groq
DEMO_FALLBACK_PROVIDER=nvidia-nim
DEMO_PLANNER_MODEL=openai/gpt-oss-20b
DEMO_WRITER_MODEL=openai/gpt-oss-20b
# Modelo comum usado somente pela sonda mínima Groq/NIM do smoke de fallback
DEMO_FALLBACK_SMOKE_MODEL=openai/gpt-oss-20b

# Serviços locais
INDUSTRIAL_API_URL=http://127.0.0.1:8000
PUBLIC_APP_URL=http://127.0.0.1:5173
DEMO_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Slack MCP oficial: OAuth user token com escopo chat:write e IDs de canal
SLACK_MCP_ACCESS_TOKEN=
SLACK_TRACTIAN_CHANNEL_ID=
SLACK_AUTHORITY_CHANNEL_ID=
